{
  "manifest_version": 3,
  "name": "Meta Auto Manager",
  "version": "1.2.0",
  "description": "Ekstensi Chrome untuk Meta Business Suite: Hapus konten otomatis, isi deskripsi, jadwal otomatis, cover upload, dengan mode tampilan Mengambang atau Sidebar.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://business.facebook.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Meta Auto Manager",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "src/dom-helpers.js",
        "src/engine.js",
        "src/composer-dom.js",
        "src/composer-engine.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "src/cover-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
