{
  "manifest_version": 3,
  "name": "Meta Content Auto Deleter",
  "version": "1.0.0",
  "description": "Ekstensi Chrome untuk menghapus konten Meta Business Suite secara otomatis: Bulk Delete atau 1 per 1 dari konten teratas.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://business.facebook.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Meta Content Auto Deleter",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "src/dom-helpers.js",
        "src/engine.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
